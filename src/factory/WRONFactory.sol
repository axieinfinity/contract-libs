pragma solidity ^0.8.0;

import { IWRON } from "../interfaces/IWRON.sol";
import { IWRONHelper } from "../interfaces/IWRONHelper.sol";
import { LibCreate } from "./LibCreate.sol";

library WRONFactory {
  function createWRON() internal returns (IWRON) {
    return IWRON(LibCreate.createViaCreationCode(WRON_CREATION_BYTECODE));
  }

  function createWRONHelper(address wron) internal returns (IWRONHelper) {
    return IWRONHelper(LibCreate.createWithConstructorArguments(WRON_HELPER_CREATION_BYTECODE, abi.encode(wron)));
  }

  // https://app.roninchain.com/tx/0x173b02466cb77851045468ff2ef8809e8c74378c026ecae8f7d7ef9d9c3b996c
  bytes internal constant WRON_CREATION_BYTECODE =
    hex"";
  // https://app.roninchain.com/tx/0xcdc704e047d813ea2248a0f7e96648c3c2fa0284ee9fd49277900a7022dcecee
  bytes internal constant WRON_HELPER_CREATION_BYTECODE =
    hex"";
}
