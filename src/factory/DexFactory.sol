pragma solidity ^0.8.0;

import { IKatanaRouter } from "../interfaces/IKatanaRouter.sol";
import { IKatanaFactory } from "../interfaces/IKatanaFactory.sol";
import { IKatanaPair } from "../interfaces/IKatanaPair.sol";
import { LibCreate } from "./LibCreate.sol";

library DexFactory {
  function createPair() internal returns (IKatanaPair) {
    return IKatanaPair(LibCreate.createViaCreationCode(PAIR_CREATION_BYTECODE));
  }

  function createRouter(address factory, address wron) internal returns (IKatanaRouter) {
    return IKatanaRouter(LibCreate.createViaRuntimeCode(ROUTER_RUNTIME_BYTECODE, abi.encode(factory, wron)));
  }

  function createFactory(address treasury, address pairImplementation) internal returns (IKatanaFactory) {
    return
      IKatanaFactory(LibCreate.createViaRuntimeCode(FACTORY_RUNTIME_BYTECODE, abi.encode(treasury, pairImplementation)));
  }

  bytes internal constant PAIR_CREATION_BYTECODE =
    hex"";

  bytes internal constant FACTORY_RUNTIME_BYTECODE =
    hex"";

  bytes internal constant ROUTER_RUNTIME_BYTECODE =
    hex"";
}
